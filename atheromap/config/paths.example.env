# Copy to paths.local.env and edit. Source this file from Bash.
# New run directories: do not point these at completed results unless intentional.
export ATHEROMAP_SCDRS_WORK_DIR="$HOME/atheromap_runs/carotid_v1/scdrs"
export ATHEROMAP_GSMAP_WORK_DIR="$HOME/atheromap_runs/carotid_v1/gsmap"

# Required only for the scDRS raw-data preprocessing step.
# This directory must contain matrix.mtx.gz, features.tsv.gz and barcodes.tsv.gz.
export ATHEROMAP_SCDRS_INPUT_DIR="/replace/with/filtered_feature_bc_matrix"

# Use the original R environment containing scDblFinder and scran.
export ATHEROMAP_RSCRIPT="Rscript"
