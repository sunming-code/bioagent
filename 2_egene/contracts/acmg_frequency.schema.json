{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explicit variant-context PopGen frequency evidence policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "variants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "variants": {
      "type": "object",
      "patternProperties": {
        "^GRCh38:chr([1-9]|1[0-9]|2[0-2]|X|Y|M):[1-9][0-9]*:[ACGT]+:[ACGT]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "basis", "population_adequacy_confirmed", "exceptions_reviewed"],
          "properties": {
            "context": {"type": "string", "minLength": 1},
            "basis": {"type": "string", "minLength": 1},
            "population_adequacy_confirmed": {"type": "boolean"},
            "exceptions_reviewed": {"type": "boolean"},
            "ba1_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "bs1_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          },
          "anyOf": [{"required": ["ba1_threshold"]}, {"required": ["bs1_threshold"]}]
        }
      },
      "additionalProperties": false
    }
  }
}
