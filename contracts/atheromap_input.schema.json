{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "sample_id", "assembly", "producer", "source_gdgpt_manifest", "source_reference_manifest", "reference", "analysis_scope", "sample", "case", "phenotypes", "ancestry", "frequency_policy", "upstream_summary", "gdgpt_analysis_status", "selection", "tasks", "classification_labels_modified", "diagnosis_established", "risk_probability", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "assembly": {"const": "GRCh38"},
    "generated_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "sample": {"type": "object", "required": ["sample_id"], "properties": {"sample_id": {"type": "string", "minLength": 1}}},
    "case": {"type": "object"},
    "phenotypes": {"type": "object"},
    "ancestry": {"type": "object"},
    "frequency_policy": {"type": "object"},
    "upstream_summary": {"type": "object"},
    "source_gdgpt_manifest": {"$ref": "#/definitions/file"},
    "source_reference_manifest": {"$ref": "#/definitions/file"},
    "reference": {"type": "object", "required": ["reference_dataset_id", "reference_scope", "species", "tissue", "expression_genome_build", "trait"], "properties": {"reference_dataset_id": {"const": "GSE159677"}, "reference_scope": {"const": "external_cohort"}, "species": {"const": "human"}, "tissue": {"type": "string", "minLength": 1}, "expression_genome_build": {"type": ["string", "null"]}, "trait": {"type": "object"}}},
    "analysis_scope": {"enum": ["reference_context_only", "matched_trait_reference_context"]},
    "gdgpt_analysis_status": {"enum": ["analyzed", "no_eligible_candidates"]},
    "selection": {"type": "object", "required": ["requested_scope", "source_task_count", "selected_task_count", "excluded_tasks"], "properties": {"requested_scope": {"enum": ["reference-context", "matched-trait"]}, "source_task_count": {"type": "integer", "minimum": 0}, "selected_task_count": {"type": "integer", "minimum": 0}, "excluded_tasks": {"type": "array"}}},
    "tasks": {"type": "array", "items": {
      "type": "object", "required": ["source_task_id", "kind", "gene", "candidate_id", "candidate", "variant_evidence", "applicability", "gdgpt_result"],
      "properties": {
        "source_task_id": {"type": "string", "minLength": 1},
        "gene": {"type": "string", "minLength": 1},
        "kind": {"enum": ["disease_candidate", "explicit_gene_exploration"]},
        "candidate_id": {"type": ["string", "null"]},
        "candidate": {"type": ["object", "null"]},
        "variant_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["normalized_id", "gene", "classification", "raw_classification", "source_GT", "frequency", "quality"], "properties": {"classification": {"enum": ["Pathogenic", "Likely pathogenic", "Uncertain significance", "Likely benign", "Benign", "not_evaluated"]}}}},
        "applicability": {"type": "object", "required": ["status", "reason", "disease_id", "trait_id", "match_method"], "properties": {"status": {"enum": ["reference_context_only", "trait_matched"]}, "reason": {"type": "string", "minLength": 1}, "disease_id": {"type": ["string", "null"]}, "trait_id": {"type": "string", "minLength": 1}, "match_method": {"enum": ["exact_curated_identifier", null]}}},
        "gdgpt_result": {"type": "object", "required": ["status", "sample_id", "task_id", "gene", "task_sha256", "input_sha256"], "properties": {"status": {"const": "complete"}}}
      }
    }},
    "classification_labels_modified": {"const": false},
    "diagnosis_established": {"const": false},
    "risk_probability": {"type": "null"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "file": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
